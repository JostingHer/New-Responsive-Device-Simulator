---
import Layout from "../layouts/Layout.astro";
import Toolbar from "../components/Toolbar.astro";
import Viewer from "../components/Viewer.astro";

const rawUrl = Astro.url.searchParams.get("url") ?? "";
const initialUrl = rawUrl.trim();
---

<Layout title="Responsive Preview">
  <Toolbar initialUrl={initialUrl} />
  <Viewer url={initialUrl} />
</Layout>

<script>
  type Device = "mobile" | "tablet" | "desktop";

  const DEVICES: Record<
    Device,
    { label: string; size: string; frameClass: string }
  > = {
    mobile: {
      label: "Mobile",
      size: "375 × 667",
      frameClass: "device-frame--mobile",
    },
    tablet: {
      label: "Tablet",
      size: "768 × 1024",
      frameClass: "device-frame--tablet",
    },
    desktop: {
      label: "Desktop",
      size: "Full width",
      frameClass: "device-frame--desktop",
    },
  };

  const urlInput = document.getElementById("url-input") as HTMLInputElement;
  const loadBtn = document.getElementById("url-load-btn") as HTMLButtonElement;
  const backBtn = document.getElementById("url-back-btn") as HTMLButtonElement;
  const globeIcon = document.getElementById("url-globe-icon") as HTMLDivElement;
  const deviceFrame = document.getElementById("device-frame") as HTMLDivElement;
  const viewportLabel = document.getElementById(
    "viewport-label",
  ) as HTMLSpanElement;
  const viewportSize = document.getElementById(
    "viewport-size",
  ) as HTMLSpanElement;
  const deviceUrlBar = document.getElementById(
    "device-url-bar",
  ) as HTMLDivElement;
  const deviceBtns =
    document.querySelectorAll<HTMLButtonElement>(".device-btn");
  const loadingOverlay = document.getElementById(
    "loading-overlay",
  ) as HTMLDivElement;
  const errorState = document.getElementById("error-state") as HTMLDivElement;

  let currentDevice: Device = "desktop";

  function getPreviewFrame(): HTMLIFrameElement | null {
    return document.getElementById("preview-frame") as HTMLIFrameElement | null;
  }

  function setDevice(device: Device) {
    currentDevice = device;
    deviceFrame.classList.remove(
      "device-frame--mobile",
      "device-frame--tablet",
      "device-frame--desktop",
    );
    deviceFrame.classList.add(DEVICES[device].frameClass);
    viewportLabel.textContent = DEVICES[device].label;
    viewportSize.textContent = DEVICES[device].size;
    deviceBtns.forEach((btn) => {
      btn.classList.toggle("device-btn--active", btn.dataset.device === device);
    });
  }

  function normalizeUrl(raw: string): string {
    const trimmed = raw.trim();
    if (!trimmed) return "";
    if (/^https?:\/\//i.test(trimmed)) return trimmed;
    return "https://" + trimmed;
  }

  const HISTORY_KEY = 'preview_history';

  function getHistory(): string[] {
    try {
      const data = localStorage.getItem(HISTORY_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveToHistory(url: string) {
    const history = getHistory();
    const index = history.indexOf(url);
    if (index !== -1) {
      history.splice(index, 1);
    }
    history.unshift(url);
    localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(0, 20))); // Keep last 20
  }

  function clearHistory() {
    localStorage.removeItem(HISTORY_KEY);
    renderHistory();
  }

  function renderHistory() {
    const container = document.getElementById("history-container");
    const grid = document.getElementById("history-grid");
    const emptyExamples = document.getElementById("empty-examples");
    
    if (!container || !grid || !emptyExamples) return;

    const history = getHistory();
    if (history.length > 0) {
      container.style.display = "flex";
      emptyExamples.style.display = "none";
      
      grid.innerHTML = "";
      history.forEach((url) => {
        try {
          const urlObj = new URL(url);
          const domain = urlObj.hostname;
          const card = document.createElement("button"); // Using button instead of div for a11y & styling matching
          card.className = "history-card";
          card.innerHTML = `
            <div class="history-card__icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </div>
            <span class="history-card__domain" title="${url}">${domain}</span>
          `;
          card.addEventListener("click", () => {
            urlInput.value = url;
            loadUrl(url);
          });
          grid.appendChild(card);
        } catch (e) {
          // ignore invalid urls
        }
      });
      
      const clearBtn = document.getElementById("clear-history-btn");
      if (clearBtn) {
        clearBtn.onclick = clearHistory;
      }
    } else {
      container.style.display = "none";
      emptyExamples.style.display = "flex";
    }
  }

  function showEmptyState() {
    if (backBtn && globeIcon) {
      backBtn.style.display = "none";
      globeIcon.style.display = "flex";
    }

    const existing = document.getElementById("preview-frame");
    if (existing) existing.remove();
    
    let emptyState = document.getElementById("empty-state");
    if (emptyState) {
      emptyState.style.display = "flex";
    }
    
    renderHistory();
    
    errorState.style.display = "none";
    loadingOverlay.style.display = "none";
    window.history.replaceState({}, "", window.location.pathname);
    urlInput.value = "";
  }

  function loadUrl(url: string) {
    if (!url) {
      showEmptyState();
      return;
    }

    deviceUrlBar.textContent = url;
    errorState.style.display = "none";
    loadingOverlay.style.display = "flex";

    if (backBtn && globeIcon) {
      backBtn.style.display = "flex";
      globeIcon.style.display = "none";
    }

    saveToHistory(url);

    const emptyState = document.getElementById("empty-state");
    if (emptyState) emptyState.style.display = "none";

    let frame = getPreviewFrame();
    if (!frame) {
      const iframeWrapper = deviceFrame.querySelector(
        ".iframe-wrapper",
      ) as HTMLDivElement;
      frame = document.createElement("iframe");
      frame.id = "preview-frame";
      frame.className = "preview-frame";
      frame.title = "Preview";
      frame.setAttribute(
        "sandbox",
        "allow-scripts allow-same-origin allow-forms allow-popups",
      );
      iframeWrapper.insertBefore(frame, loadingOverlay);
    }

    const newSearch = new URLSearchParams({ url });
    window.history.replaceState(
      {},
      "",
      `${window.location.pathname}?${newSearch.toString()}`,
    );

    const loadTimeout = setTimeout(() => {
      if (loadingOverlay.style.display !== "none") {
        loadingOverlay.style.display = "none";
        errorState.style.display = "flex";
      }
    }, 12000);

    frame.onload = () => {
      clearTimeout(loadTimeout);
      loadingOverlay.style.display = "none";
      errorState.style.display = "none";

      function resizeViewer() {
        const frame = getPreviewFrame();
        if (!frame) return;

        const navbarH =
          (document.querySelector(".toolbar") as HTMLElement)?.offsetHeight ??
          48;
        const infoH =
          (document.querySelector(".viewport-info") as HTMLElement)
            ?.offsetHeight ?? 32;
        const padding = 40;

        const availableH = window.innerHeight - navbarH - infoH - padding;

        deviceFrame.style.height = `${availableH}px`;
        frame.style.width = "100%";
        frame.style.height = "100%";
      }

      resizeViewer();
    };

    frame.src = url;
  }

  function handleUrlSubmit() {
    const normalized = normalizeUrl(urlInput.value);
    if (normalized) {
      urlInput.value = normalized;
      loadUrl(normalized);
    } else {
      showEmptyState();
    }
  }

  function attachExampleListeners(btns: NodeListOf<HTMLButtonElement>) {
    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const url = btn.dataset.url ?? "";
        urlInput.value = url;
        loadUrl(url);
      });
    });
  }

  deviceBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const device = btn.dataset.device as Device;
      if (device) setDevice(device);
    });
  });

  urlInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") handleUrlSubmit();
  });

  loadBtn.addEventListener("click", handleUrlSubmit);
  if (backBtn) {
    backBtn.addEventListener("click", showEmptyState);
  }

  // Attach listeners to static SSR example buttons
  const staticExamples = document.querySelectorAll<HTMLButtonElement>(
    "#empty-state .example-url",
  );
  attachExampleListeners(staticExamples);

  // Detect initial device based on viewport
  function detectInitialDevice(): Device {
    if (window.innerWidth <= 480) return "mobile";
    if (window.innerWidth <= 1024) return "tablet";
    return "desktop";
  }

  setDevice(detectInitialDevice());

  // Render history on mount if we're in empty state (which we are currently assuming unless there's a url)
  renderHistory();

  const urlParams = new URLSearchParams(window.location.search);
  const initialUrl = urlParams.get("url");
  if (initialUrl) {
    urlInput.value = initialUrl;
    loadUrl(initialUrl);
  } else {
    showEmptyState();
  }
</script>
