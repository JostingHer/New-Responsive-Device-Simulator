---
interface Props {
  title?: string;
}
const { title = 'Responsive Preview' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style>
      :root {
        --color-bg:          #0a0a0a;
        --color-surface:     #111111;
        --color-surface-2:   #1a1a1a;
        --color-border:      #2a2a2a;
        --color-border-hover:#3a3a3a;
        --color-cyan:        #00d1ff;
        --color-cyan-dim:    rgba(0, 209, 255, 0.12);
        --color-cyan-glow:   rgba(0, 209, 255, 0.25);
        --color-purple:      #7000ff;
        --color-purple-dim:  rgba(112, 0, 255, 0.12);
        --color-text:        #ffffff;
        --color-text-muted:  #888888;
        --color-text-dim:    #555555;
        --navbar-h:          56px;
        --radius-sm:         6px;
        --radius-md:         10px;
        --radius-lg:         16px;
        --transition:        0.25s cubic-bezier(0.4, 0, 0.2, 1);
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        height: 100%;
        background: var(--color-bg);
        color: var(--color-text);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow: hidden;
      }

      #app {
        display: flex;
        flex-direction: column;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <div id="app">
      <slot />
    </div>
  </body>
</html>
